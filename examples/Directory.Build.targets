<Project>
    <!--
    MSBuild imports only the NEAREST Directory.Build.targets, so the repository-root one is imported
    explicitly; guarded so this file does not break if that one is ever removed.
  -->
    <PropertyGroup>
        <!-- Hoisted into a property first: MSBuild's Condition parser cannot handle the nested quotes
         of a property-function call written inline. -->
        <_ParentDirectoryBuildTargets>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))</_ParentDirectoryBuildTargets>
    </PropertyGroup>

    <Import Project="$(_ParentDirectoryBuildTargets)" Condition="'$(_ParentDirectoryBuildTargets)' != ''" />

    <!-- Drops package XML docs and native symbol files from the output; shared with tests/ and tools/. -->
    <Import Project="$(MSBuildThisFileDirectory)../build/HostRuntime.targets" />
</Project>