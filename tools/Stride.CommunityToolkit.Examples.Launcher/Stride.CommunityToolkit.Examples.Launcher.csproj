<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    </ItemGroup>

    <!--
        Manifest reading is shared with the console runner. The files are linked rather than split into
        a library because both launchers are single-project tools and a third project to hold four types
        would cost more than it saves.
    -->
    <ItemGroup>
        <Compile Include="..\Stride.CommunityToolkit.Examples\Core\Constants.cs" Link="Core\Constants.cs" />
        <Compile Include="..\Stride.CommunityToolkit.Examples\Core\ExampleManifest.cs" Link="Core\ExampleManifest.cs" />
        <Compile Include="..\Stride.CommunityToolkit.Examples\Core\ExampleEntry.cs" Link="Core\ExampleEntry.cs" />
        <Compile Include="..\Stride.CommunityToolkit.Examples\Core\ManifestLoader.cs" Link="Core\ManifestLoader.cs" />
    </ItemGroup>

    <!--
        A build-order dependency, not a code one: ReferenceOutputAssembly="false" keeps the generator's
        assembly out of this project entirely. It is here so MSBuild builds the generator once, before
        this project, rather than leaving the pre-build hook to build it - see ExamplesManifest.targets.
    -->
    <ItemGroup>
        <ProjectReference Include="..\Stride.CommunityToolkit.Examples.MetadataGenerator\Stride.CommunityToolkit.Examples.MetadataGenerator.csproj"
                          ReferenceOutputAssembly="false"
                          Private="false" />
    </ItemGroup>

    <!-- Generates examples-manifest.json before the build and copies it to the output. -->
    <Import Project="..\ExamplesManifest.targets" />

</Project>
