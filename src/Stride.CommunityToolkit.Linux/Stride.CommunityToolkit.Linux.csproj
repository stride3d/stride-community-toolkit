<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>Stride Community Toolkit - Linux</Title>
        <Description>This library serves to simplify the setup for Stride code-only projects on Linux by automatically including the `Stride.AssetCompiler` package and copying the native libraries its asset compilers need. This eliminates the need for manual file copying and boilerplate code, making it easier to demonstrate and develop simple Stride projects on Linux without additional configuration.$(StrideVersionNote)</Description>
        <!-- Consuming applications need <RuntimeIdentifier>linux-x64</RuntimeIdentifier>; the copy
             target below keys off it. Stride 4.4 selects Vulkan on Linux by itself, so the
             StrideGraphicsApi override that used to be needed here is gone. -->
    </PropertyGroup>

    <Import Project="..\CommonSettings.props" />

    <ItemGroup>
        <!-- This library requires a shader defined in the engine assemblies. Shaders are assets typically compiled by the asset compiler according to the Graphics API target, necessitating the inclusion of Stride.AssetCompiler. -->
        <PackageReference Include="Stride.AssetCompiler" Version="$(StrideVersion)" IncludeAssets="build;buildTransitive" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Stride.CommunityToolkit\Stride.CommunityToolkit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Shipped in both folders so the target reaches direct and transitive consumers alike.
             Packing it is the whole point: as an inline <Target> in this file it only ever ran when
             building this project, which is not where assets get compiled. -->
        <None Include="build\Stride.CommunityToolkit.Linux.targets" Pack="true" PackagePath="build\;buildTransitive\" />
    </ItemGroup>

    <!-- Imported as well as packed, so a malformed targets file breaks this build rather than only
         breaking consumers. It is a no-op here: the conditions require a linux RID. -->
    <Import Project="build\Stride.CommunityToolkit.Linux.targets" />

</Project>
