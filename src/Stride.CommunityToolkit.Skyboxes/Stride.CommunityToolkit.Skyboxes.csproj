<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>Stride Community Toolkit - Skybox</Title>
        <Description>A skybox for code-only Stride projects in one call. game.AddSkybox() adds an entity with a BackgroundComponent and a skybox LightComponent built from a bundled HDR environment map, so a scene gets a sky and image-based lighting without any assets of its own.

What's inside:
- AddSkybox(): the one-call setup, with a bundled HDR texture
- SkyboxGenerator: turns any cubemap or HDR texture into a Stride Skybox at run time, for your own environment maps$(StrideVersionNote)</Description>
    </PropertyGroup>

    <Import Project="..\CommonSettings.props" />

    <ItemGroup>
        <PackageReference Include="Stride.Engine" Version="$(StrideVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Stride.CommunityToolkit\Stride.CommunityToolkit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Resources\skybox_texture_hdr.dds" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Resources\skybox_texture_hdr.dds">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

</Project>