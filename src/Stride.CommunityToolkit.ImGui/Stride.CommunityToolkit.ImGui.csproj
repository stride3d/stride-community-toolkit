<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>Stride Community Toolkit - ImgGui</Title>
        <Description>
            A specialized extension of the Stride Community Toolkit, providing easy-to-use ImGui utilities for Stride projects. Enhance your Stride scenes with dynamic UI without needing additional assets or complex setup.$(StrideVersionNote)
        </Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <Import Project="..\CommonSettings.props" />

    <ItemGroup>
        <None Include="Assets\*.*" Pack="true" PackagePath="stride\Assets" />
        <None Include="Resources\*.*" Pack="true" PackagePath="stride\Resources" />
        <None Include="Effects\*.*" Pack="true" PackagePath="stride\Effects" />
        <None Include="*.sdpkg" Pack="true" PackagePath="stride" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
        <PackageReference Include="Stride.AssetCompiler" Version="4.4.0-beta4" IncludeAssets="build;buildTransitive" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Stride.CommunityToolkit\Stride.CommunityToolkit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Effects\ImGuiShader.sdsl">
            <LastGenOutput>ImGuiShader.sdsl.cs</LastGenOutput>
        </None>
    </ItemGroup>

</Project>
