<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>Stride Community Toolkit - Windows (superseded)</Title>
        <Description>Superseded: reference Stride.CommunityToolkit instead. Since 1.0.0-preview.67 the core package brings in the asset compiler and holds WindowsDpiManager, so this package is empty and only depends on the core. It is published once more so that a project still naming it keeps building with the matching core; it will be unlisted.$(StrideVersionNote)</Description>
        <!--
            An empty package that forwards to the core. Without it, a project that still references this package
            with a floating prerelease version would pair the old 1.0.0-preview.66 assembly with the new core and
            have WindowsDpiManager twice. No build output is packed; the core is the one dependency.
        -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <Import Project="..\CommonSettings.props" />

    <ItemGroup>
        <ProjectReference Include="..\Stride.CommunityToolkit\Stride.CommunityToolkit.csproj" />
    </ItemGroup>

</Project>
