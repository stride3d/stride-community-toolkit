namespace Stride.CommunityToolkit.Shapes
{
    // The distance functions behind ShapeShader: signed distances in the shape's normalized local
    // space, negative inside, for a convex polygon, a polyline, the wedge of an angular cut and the
    // gaps of a dash pattern. A shape's points live in one buffer shared by every shape of the
    // draw, addressed by where the shape's run starts and how many points it has, so a shape can
    // have any number of them. No streams, no stages - the functions compose into any shader, and
    // are callable qualified (ShapeDistance.SdPolyline) without inheriting the class.
    internal shader ShapeDistance : Math
    {
        rgroup PerDraw.ShapePoints
        {
            // Every shape's points, already shifted and scaled into its own normalized space
            stage StructuredBuffer<float2> Points;

            // The points of every space run: xyz a world position, w the stroke radius there in
            // world units, 0 for a stroke measured in pixels
            stage StructuredBuffer<float4> SpacePoints;
        }

        float Cross2d(float2 v1, float2 v2)
        {
            return v1.x * v2.y - v1.y * v2.x;
        }

        // Signed distance to the nearest gap in the dash pattern, measured along the outline and
        // returned in local units, negative inside a dash. Around a circle the coordinate is the
        // angle from the shape's start direction times the stroke's centreline radius; along a line
        // it is the projection onto the segment. The pattern is fitted so a whole number of periods
        // fills a circle or arc, so a tick ring never ends in a stub.
        //
        // localPerPixelCentre: local units per screen pixel at the shape's centre - one figure for
        // the whole shape, so every fragment of a ring agrees on how many dashes it holds; measured
        // per fragment, the near and far sides of a ring seen in perspective disagreed and the
        // pattern fell apart. A ring's dashes are therefore sized in its own units and foreshorten
        // with it, like marks painted on the ground. Along a line the coordinate's own screen
        // derivative gives the local units per pixel in the outline's direction, which holds under
        // any foreshortening where a figure from depth alone holds only facing the camera.
        // pattern: dash and gap lengths and the phase, all in pixels; startDirection: the cut's
        // first edge direction, or +X when there is no cut. Along a polyline the coordinate is the
        // arc length to the nearest point of the run, plus runOffset - where this run starts along
        // a longer one - so the pattern continues across the pieces of a very long run.
        float SdDashes(float2 p, uint offset, int count, bool hollow, bool cut, float radius, float ringWidth, float sweep, float localPerPixel, float localPerPixelCentre, float3 pattern, float2 startDirection, bool polyline, float runOffset)
        {
            float dash = pattern.x;
            float gap = pattern.y;
            float period = dash + gap;
            float phase = pattern.z;

            if (count == 1 && !polyline)
            {
                float centreline = hollow ? radius - 0.5 * ringWidth : radius;
                float startAngle = atan2(startDirection.y, startDirection.x);
                float angle = atan2(p.y, p.x) - startAngle;

                angle -= 2.0 * PI * floor(angle / (2.0 * PI));

                // Fit: stretch or squeeze the period so the turn holds a whole number of them,
                // the pattern then held in local units for the whole ring
                float turn = (cut ? sweep : 2.0 * PI) * centreline;
                float periods = max(1.0, round(turn / (period * localPerPixelCentre)));
                float periodLocal = turn / periods;
                float dashLocal = periodLocal * dash / period;

                return SdDashAlong(angle * centreline + phase * localPerPixelCentre, dashLocal, periodLocal, 1.0, 0.0);
            }

            float along;

            if (polyline)
            {
                along = PolylineAlong(p, offset, count) + runOffset;
            }
            else
            {
                float2 direction = Points[offset + 1] - Points[offset];
                float segment = length(direction);

                along = segment > 0.0 ? dot(p - Points[offset], direction / segment) : 0.0;
            }

            // Capped either side of the depth figure: at a crease between two segments the
            // derivative has nothing to say
            float alongPerPixel = clamp(length(float2(ddx(along), ddy(along))), 0.25 * localPerPixel, 4.0 * localPerPixel);

            return SdDashAlong(along, dash, period, alongPerPixel, phase);
        }

        // The dash pattern at a coordinate along the outline: the coordinate in pixels, folded
        // into one period, and the signed distance to the nearest dash edge - inside a dash the
        // closer of its two ends, in a gap likewise - returned in local units, negative in a dash.
        float SdDashAlong(float along, float dash, float period, float localPerPixel, float phase)
        {
            float u = along / localPerPixel + phase;

            u -= period * floor(u / period);

            float d = u < dash ? min(u, dash - u) : -min(u - dash, period - u);

            return -d * localPerPixel;
        }

        // A space point on screen: xy in pixels, y down, from the same projection the vertex stage
        // uses; z the stroke radius there in pixels; w the depth the rasterizer would give it. A
        // point behind the camera has its w clamped, which keeps the arithmetic finite; a run that
        // crosses the near plane is not supported.
        float4 ProjectSpacePoint(float4 spacePoint, float4x4 viewProjection, float2 viewSize, float pixelsPerUnit)
        {
            float4 clip = mul(float4(spacePoint.xyz, 1.0), viewProjection);
            float w = max(clip.w, 0.0001);
            float2 ndc = clip.xy / w;

            return float4((ndc.x * 0.5 + 0.5) * viewSize.x, (0.5 - ndc.y * 0.5) * viewSize.y, spacePoint.w * pixelsPerUnit / w, clip.z / w);
        }

        // Signed distance in pixels from a screen position to a space run: the nearest of its
        // segments, each one's radius interpolated between its ends, so a world-width stroke
        // narrows with distance the way a rope does. Negative inside the stroke. Also the depth of
        // the nearest point of the run, for the fragment to write: depth is affine along a
        // projected segment, so the screen-space parameter interpolates it exactly.
        float SdSpacePolyline(float2 pixel, uint offset, int count, float4x4 viewProjection, float2 viewSize, float pixelsPerUnit, out float depth)
        {
            float4 previous = ProjectSpacePoint(SpacePoints[offset], viewProjection, viewSize, pixelsPerUnit);
            float d = length(pixel - previous.xy) - previous.z;

            depth = previous.w;

            for (int i = 1; i < count; ++i)
            {
                float4 current = ProjectSpacePoint(SpacePoints[offset + i], viewProjection, viewSize, pixelsPerUnit);
                float2 e = current.xy - previous.xy;
                float2 toPixel = pixel - previous.xy;
                float t = clamp(dot(toPixel, e) / max(dot(e, e), 0.000001), 0.0, 1.0);
                float2 b = toPixel - e * t;
                float segment = length(b) - lerp(previous.z, current.z, t);

                if (segment < d)
                {
                    d = segment;
                    depth = lerp(previous.w, current.w, t);
                }

                previous = current;
            }

            return d;
        }

        // Arc length in pixels along a space run's projection to the point of it nearest the
        // screen position, for a dash pattern: PolylineAlong over the projected points.
        float SpacePolylineAlong(float2 pixel, uint offset, int count, float4x4 viewProjection, float2 viewSize)
        {
            float best = 1e30;
            float along = 0.0;
            float travelled = 0.0;
            float2 previous = ProjectSpacePoint(SpacePoints[offset], viewProjection, viewSize, 0.0).xy;

            for (int i = 1; i < count; ++i)
            {
                float2 current = ProjectSpacePoint(SpacePoints[offset + i], viewProjection, viewSize, 0.0).xy;
                float2 e = current - previous;
                float2 w = pixel - previous;
                float ee = max(dot(e, e), 0.000001);
                float t = clamp(dot(w, e) / ee, 0.0, 1.0);
                float2 b = w - e * t;
                float bb = dot(b, b);
                float segment = sqrt(ee);

                if (bb < best)
                {
                    best = bb;
                    along = travelled + t * segment;
                }

                travelled += segment;
                previous = current;
            }

            return along;
        }

        // Distance to a run of points - the nearest of its segments. A stroke of some radius around
        // it is then the run itself with round joins and round caps, with no geometry for either.
        float SdPolyline(float2 p, uint offset, int count)
        {
            float2 previous = Points[offset];
            float d = dot(p - previous, p - previous);

            for (int i = 1; i < count; ++i)
            {
                float2 current = Points[offset + i];
                float2 e = current - previous;
                float2 w = p - previous;
                float2 b = w - e * clamp(dot(w, e) / max(dot(e, e), 0.000001), 0.0, 1.0);

                d = min(d, dot(b, b));
                previous = current;
            }

            return sqrt(d);
        }

        // Arc length along the run to the point of it nearest p: the segments before the nearest
        // one in full, plus the projection onto it. What a dash pattern runs along.
        float PolylineAlong(float2 p, uint offset, int count)
        {
            float best = 1e30;
            float along = 0.0;
            float travelled = 0.0;
            float2 previous = Points[offset];

            for (int i = 1; i < count; ++i)
            {
                float2 current = Points[offset + i];
                float2 e = current - previous;
                float2 w = p - previous;
                float ee = max(dot(e, e), 0.000001);
                float t = clamp(dot(w, e) / ee, 0.0, 1.0);
                float2 b = w - e * t;
                float bb = dot(b, b);
                float segment = sqrt(ee);

                if (bb < best)
                {
                    best = bb;
                    along = travelled + t * segment;
                }

                travelled += segment;
                previous = current;
            }

            return along;
        }

        // Signed distance to the wedge between two edge directions from the origin, sweeping
        // counter-clockwise from the first to the second; negative inside. Exact along the edges
        // and inside; outside a corner it is the Chebyshev distance, which keeps the corner sharp.
        float SdWedge(float2 p, float4 edges, float sweep)
        {
            float2 u1 = edges.xy;
            float2 u2 = edges.zw;

            // Which side of each edge the point lies on, with the sign chosen so that positive
            // means "on the wedge's side". Past a half turn the wedge is the complement of the
            // narrow one between the same edges, and the test flips with it.
            float c1 = Cross2d(u1, p);
            float c2 = Cross2d(p, u2);
            bool inside = sweep <= PI ? (c1 >= 0.0 && c2 >= 0.0) : (c1 > 0.0 || c2 > 0.0);

            // Distance to each edge as a ray: perpendicular while alongside it, to the origin behind it
            float d1 = dot(p, u1) > 0.0 ? abs(c1) : length(p);
            float d2 = dot(p, u2) > 0.0 ? abs(c2) : length(p);

            return (inside ? -1.0 : 1.0) * min(d1, d2);
        }

        // Signed distance function for a convex polygon; relies on CCW winding of the points
        float SdConvexPolygon(float2 p, uint offset, int count)
        {
            float2 first = Points[offset];

            // Initial squared distance
            float d = dot(p - first, p - first);

            // Consider query point inside to start
            float side = -1.0;
            float2 previous = Points[offset + count - 1];

            for (int i = 0; i < count; ++i)
            {
                float2 current = Points[offset + i];

                // Distance to a polygon edge
                float2 e = current - previous;
                float2 w = p - previous;
                float we = dot(w, e);
                float2 b = w - e * clamp(we / dot(e, e), 0.0, 1.0);
                float bb = dot(b, b);

                // Track smallest distance
                if (bb < d)
                {
                    d = bb;
                }

                // If the query point is outside any edge then it is outside the entire polygon
                float s = Cross2d(w, e);
                if (s >= 0.0)
                {
                    side = 1.0;
                }

                previous = current;
            }

            return side * sqrt(d);
        }
    };
}