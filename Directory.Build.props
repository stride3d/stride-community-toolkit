<Project>
  <!--
    Auto-imported by MSBuild into every project in this repository.
    Shared settings live here so a Stride upgrade is a one-line change.
    Projects may override any of these locally (e.g. Stride.CommunityToolkit.Linux pins its own StrideVersion).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StrideVersion>4.4.0</StrideVersion>

    <!--
      Appended to every package <Description>. It has to be defined here, not in src/CommonSettings.props:
      the package projects set Description before importing that file, and MSBuild expands properties in
      evaluation order, so a note defined later would expand to nothing (which is what used to happen).
    -->
    <StrideVersionNote>

Stride compatibility (each toolkit version is built for one Stride release):
- Stride 4.4: this version
- Stride 4.3: 1.0.0-preview.62
- Stride 4.2: 1.0.0-preview.61

Documentation: https://stride3d.github.io/stride-community-toolkit/
Source and 50+ runnable examples: https://github.com/stride3d/stride-community-toolkit</StrideVersionNote>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SolutionDir)' != ''">
    <ErrorLog>$(SolutionDir)\.sarif\$(MSBuildProjectName).json</ErrorLog>
  </PropertyGroup>

  <!--
    SixLabors.ImageSharp 3.1.12 comes from Stride.Foundation, not from the toolkit, and 4.1.2 fixes these
    advisories. Referencing 4.x here would replace the version Stride is compiled against, so they are
    suppressed one by one, and any new advisory still warns. Remove this group once Stride ships ImageSharp 4.1.2.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>
  <!--
    System.Security.Cryptography.Pkcs 8.0.1 is reached through Stride.AssetCompiler (Stride.Assets, the template
    engine), not referenced by the toolkit; the two advisories of 2026-10-14 are suppressed the same way. Remove
    them once Stride moves off that version. The third is E13_SignalR's SignalR client 10.0.12: the advisory
    names 10.0.13 as fixed, and that package was not on the feed on 2026-10-14. Bump the example and remove the
    line once it is.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-334f-vvp4-7g6p" />
  </ItemGroup>
  <!--
    Local overrides, never committed. A Directory.Build.local.props beside this file is imported last, so it
    can point StrideVersion at a locally built engine (4.4.0-dev). CI has no such package, which is why the
    version committed above stays a released one. See docs/contributing/toolkit/building.md.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
</Project>